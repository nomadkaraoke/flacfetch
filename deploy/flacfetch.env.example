# flacfetch static secrets — copy to /etc/flacfetch/flacfetch.env, chmod 600.
# These are the values currently held in GCP Secret Manager; pull each with:
#   gcloud secrets versions access latest --secret=<name> --project=nomadkaraoke
#
# Rotating credentials (youtube-cookies, spotify-oauth-token) are NOT here —
# they stay in Secret Manager and are reached at runtime via the SA key.

# karaoke-gen <-> flacfetch shared API key (secret: flacfetch-api-key)
FLACFETCH_API_KEY=

# RED (redacted.sh) private tracker
RED_API_KEY=
RED_API_URL=

# OPS (orpheus.network) private tracker
OPS_API_KEY=
OPS_API_URL=

# Spotify app credentials (Spotify Premium capture)
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# Pushbullet (credential health-check notifications)
PUSHBULLET_API_KEY=

# Credential keeper Google account (YouTube cookies + Spotify "Login with Google")
FLACFETCH_ACCOUNT_EMAIL=
FLACFETCH_ACCOUNT_PASSWORD=

# Optional overrides (defaults shown):
# GCS_BUCKET=karaoke-gen-storage-nomadkaraoke
# SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
